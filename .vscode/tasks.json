{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build_test",
      "type": "shell",
      "command": "make -j$(nproc) ${fileBasenameNoExtension}",
      "group": "build",
      "problemMatcher": ["$gcc", "$clang"],
      "detail": "CMake Build Task",
      "options": {
        "cwd": "${workspaceFolder}/build"
      }
    },
    {
      "label": "build_sqllogictest",
      "type": "shell",
      "command": "make -j$(nproc) sqllogictest",
      "group": "build",
      "problemMatcher": ["$gcc", "$clang"],
      "detail": "CMake Build Task",
      "options": {
        "cwd": "${workspaceFolder}/build"
      }
    }
  ]
}
